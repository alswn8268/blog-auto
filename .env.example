# ── 벡터 DB ────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=gyu_law_articles

# ── 모델 ───────────────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBED_USE_FP16=true

# ── LLM (Ollama) ───────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_TIMEOUT=180

# ── 검색 파라미터 ──────────────────────────────────────────────────────────
RETRIEVE_TOP_K=20
RERANK_TOP_K=5

# ── 경로 ───────────────────────────────────────────────────────────────────
DATA_DIR=./data/raw
LOG_DIR=./logs

# ── 보안 ───────────────────────────────────────────────────────────────────
# 감사로그 가명화용 솔트. 운영에서는 반드시 임의값으로 교체하고 외부에 노출하지 않는다.
AUDIT_SALT=change-me-in-production
# 감사로그 보존기간(일). 재단 개인정보 처리방침상 보유기간에 맞춰 조정.
RETENTION_DAYS=90

# ── 버전 태깅 (4.5 회고적 비교용) ──────────────────────────────────────────
PROMPT_VERSION=v1
