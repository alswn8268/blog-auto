# ── 벡터 DB ────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=gyu_law_articles

# ── 모델 ───────────────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBED_USE_FP16=true
# dense 벡터 차원 — 임베딩 모델을 바꾸면 함께 바꿀 것 (bge-m3는 1024)
EMBED_DIM=1024

# ── LLM (Ollama) ───────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_TIMEOUT=180

# ── 검색 파라미터 ──────────────────────────────────────────────────────────
RETRIEVE_TOP_K=20
RERANK_TOP_K=5
# 융합 전 각 갈래에서 몇 배로 뽑을지 (크게 잡으면 리콜↑ 지연시간↑)
PREFETCH_MULTIPLIER=2
# 융합 방식: rrf(순위 기반, 기본) | dbsf(점수 분포 기반)
FUSION=rrf

# ── 고도화 (7장 1·2단계) ───────────────────────────────────────────────────
# Multi-Query: 질문을 N개 표현으로 펼쳐 함께 검색. 0이면 끔.
# 리콜은 오르지만 LLM 호출이 한 번 더 들고 지연시간이 늘어난다.
# 켜기 전에 `python -m eval.run_ragas`로 효과를 확인할 것.
MULTI_QUERY_N=0
# 도메인 라우팅: 질문 성격으로 검색 대상 문서종류를 좁힘. 확신 없으면 좁히지 않음.
ROUTING_ENABLED=false

# ── 경로 ───────────────────────────────────────────────────────────────────
DATA_DIR=./data/raw
LOG_DIR=./logs

# ── 보안 ───────────────────────────────────────────────────────────────────
# 감사로그 가명화용 솔트. 운영에서는 반드시 임의값으로 교체하고 외부에 노출하지 않는다.
AUDIT_SALT=change-me-in-production
# 감사로그 보존기간(일). 재단 개인정보 처리방침상 보유기간에 맞춰 조정.
RETENTION_DAYS=90

# ── 버전 태깅 (4.5 회고적 비교용) ──────────────────────────────────────────
PROMPT_VERSION=v1
